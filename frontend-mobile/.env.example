# Aroha mobile environment variables
# Copy this file to .env and fill in real values, or pass them through EAS / Expo Constants.
# All values are read by Expo at build time. Variables prefixed with EXPO_PUBLIC_ are inlined
# into the client bundle.

# REST API base URL (must include /api/v1 prefix). Required for production builds.
EXPO_PUBLIC_API_BASE_URL=https://api.aroha.app/api/v1

# Socket.IO origin (do NOT include the /ws namespace path; required for production)
EXPO_PUBLIC_WS_URL=https://api.aroha.app

# Optional: TURN/STUN configuration for WebRTC.
# Comma separated list of STUN urls.
EXPO_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN server (only set if you operate one).
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=

# Set to "1" to short-circuit API calls to persistent local demo fixtures so
# you can click through screens without a backend. Production builds ignore it.
EXPO_PUBLIC_USE_FIXTURES=0
