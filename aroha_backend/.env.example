NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=aroha-backend

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aroha?schema=public
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aroha_shadow?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=300000
DATABASE_MAX_LIFETIME_SECONDS=0

REDIS_URL=redis://localhost:6379/0
BULLMQ_PREFIX=aroha

JWT_ACCESS_SECRET=replace-with-64-char-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_GRACE_SECONDS=30
PASSWORD_PEPPER=replace-with-64-char-secret
REFRESH_TOKEN_PEPPER=replace-with-64-char-secret

# Phone OTP is disabled until one real SMS verification provider is configured.
# OTP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=VA...
#
# Or, for MSG91:
# OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
OTP_PROVIDER=disabled
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_REQUEST_TIMEOUT_MS=8000

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_BUCKET_PROFILE_PHOTOS=profile-photos
OBJECT_STORAGE_BUCKET_MESSAGE_ATTACHMENTS=message-attachments
OBJECT_STORAGE_BUCKET_VIBE_MEDIA=vibe-media

VIBES_ENABLED=true
# Optional, consent-based introduction through the existing voice-call stack.
RTC_VOICE_INTRODUCTIONS_ENABLED=true
RTC_INTRODUCTION_SUGGESTED_SECONDS=180
BLIND_EVENT_WEEKDAY=4
BLIND_EVENT_START_HOUR_IST=20
BLIND_EVENT_DURATION_MINUTES=120
# RTC_STUN_URLS and production TURN credentials must be supplied by the operator.
VIBE_MAX_DURATION_SECONDS=5
VIBE_MAX_VIDEO_SIZE_BYTES=41943040
VIBE_MAX_MUSIC_SIZE_BYTES=12582912
VIBE_UPLOAD_TTL_SECONDS=900
VIBE_PLAYBACK_URL_TTL_SECONDS=900
# Production defaults to manual and must never use the development stub.
VIBE_MODERATION_PROVIDER=manual

# Scene discovery is server-authorized by the scenes.v1 database feature flag.
SCENE_LIFETIME_HOURS=12
SCENE_RADIUS_METERS=15000
SCENE_LOCATION_MAX_AGE_HOURS=168
SCENE_DISCOVERY_CACHE_SECONDS=120

# Casual meetup discovery uses Yariva's reviewed catalog. Google Maps is opened
# through universal Maps URLs on the client, which do not require an API key.
# Maximum source-review age for the real Events places fallback (1–365 days).
VENUE_REVIEW_MAX_AGE_DAYS=30
VENUE_SUGGESTIONS_ENABLED=true
VENUE_SUGGESTION_RADIUS_METERS=15000
VENUE_SUGGESTION_LIMIT=8

# Native push tokens are registered by provider. Configure either or both transports.
PUSH_REQUEST_TIMEOUT_MS=8000
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# APNS_BUNDLE_ID=com.yariva.app
# APNS_USE_SANDBOX=false
