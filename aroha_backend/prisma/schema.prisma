  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  responses DuoPlanResponse[]
  revisions DuoPlanRevision[]
  @@index([conversationId, createdAt])
}

model DuoPlanResponse {
  planId String @db.Uuid
  userId String @db.Uuid
  version Int
  response DatePlanResponseType
  updatedAt DateTime @updatedAt
  plan DuoPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([planId, userId, version])
}

model DuoPlanRevision {
  requestId String @id @db.Uuid
  planId String @db.Uuid
  userId String @db.Uuid
