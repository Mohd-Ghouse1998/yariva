enum EventListingStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

enum EventCategory {
  CULTURE
  MUSIC
  FOOD
  OUTDOORS
  WORKSHOP
  COMMUNITY
}

// Curated public listings; saving or inviting never publishes attendance.
model EventListing {
  id              String             @id @default(uuid()) @db.Uuid
  version         Int                @default(1)
  status          EventListingStatus @default(DRAFT)
  title           String             @db.VarChar(140)
  description     String             @db.VarChar(1000)
  category        EventCategory
  city            String             @db.VarChar(120)
  locality        String             @db.VarChar(160)
  venueName       String             @db.VarChar(200)
  venueAddress    String             @db.VarChar(500)
  startsAt        DateTime
  endsAt          DateTime
  timezone        String             @db.VarChar(64)
  priceMinPaise   Int?
  priceMaxPaise   Int?
  currency        String             @default("INR") @db.Char(3)
  sourceUrl       String             @db.VarChar(1024)
  sourceName      String             @db.VarChar(120)
  bookingUrl      String?            @db.VarChar(1024)
  imageUrl        String?            @db.VarChar(1024)
  imageRights     String?            @db.VarChar(500)
  verifiedAt      DateTime
  dedupeKey       String             @unique @db.VarChar(64)
