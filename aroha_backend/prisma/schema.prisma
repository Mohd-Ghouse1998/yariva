  idempotencyKey      String?        @db.VarChar(128)
  acceptedAt          DateTime?
  declinedAt          DateTime?
  cancelledAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  match         Match              @relation(fields: [matchId], references: [id], onDelete: Restrict)
  createdByUser User               @relation("DatePlanCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedVenue ReviewedVenue?     @relation(fields: [reviewedVenueId], references: [id], onDelete: SetNull)
