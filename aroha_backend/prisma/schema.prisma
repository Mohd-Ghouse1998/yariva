model User {
  id                String     @id @default(uuid()) @db.Uuid
  /// PostgreSQL unique indexes allow multiple NULLs here, which matches the requirement.
  email             String?    @unique @db.VarChar(320)
  phone             String?    @unique @db.VarChar(32)
  passwordHash      String     @db.VarChar(255)
  role              UserRole   @default(USER)
  status            UserStatus @default(ACTIVE)
  isShadowBanned    Boolean    @default(false)
  isDiscoveryFrozen Boolean    @default(false)
  isChatFrozen      Boolean    @default(false)
  isCallFrozen      Boolean    @default(false)
  lastActiveAt      DateTime?
  suspendedAt       DateTime?
  bannedAt          DateTime?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions                   UserSession[]
  savedEvents                SavedEvent[]
  pushTokens                 PushToken[]
  profile                    UserProfile?
  photos                     ProfilePhoto[]
  intents                    UserIntent[]
  interests                  UserInterest[]
  lifestyle                  UserLifestyle?
  schedulePreference         UserSchedulePreference?
  discoveryPreference        UserDiscoveryPreference?
  communicationPreference    UserCommunicationPreference?
  outgoingLikes              Like[]                       @relation("LikeActor")
  incomingLikes              Like[]                       @relation("LikeTarget")
  outgoingPasses             Pass[]                       @relation("PassActor")
  incomingPasses             Pass[]                       @relation("PassTarget")
  matchesLow                 Match[]                      @relation("MatchUserLow")
  matchesHigh                Match[]                      @relation("MatchUserHigh")
  matchCommunicationSettings MatchCommunicationSetting[]
  sentMessages               Message[]                    @relation("MessageSender")
  conversationReads          ConversationRead[]
  conversationMemberships    ConversationMember[]
  duoPlanResponses           DuoPlanResponse[]
  duoPlanRevisions           DuoPlanRevision[]
  initiatedCalls             CallSession[]                @relation("CallInitiator")
  receivedCalls              CallSession[]                @relation("CallReceiver")
  blocksInitiated            Block[]                      @relation("Blocker")
  blocksReceived             Block[]                      @relation("Blocked")
  reportsFiled               Report[]                     @relation("ReportReporter")
  reportsAgainst             Report[]                     @relation("ReportReported")
  moderationCasesSubject     ModerationCase[]             @relation("ModerationSubject")
  moderationCasesAssigned    ModerationCase[]             @relation("ModerationAssignee")
  trustScore                 TrustScore?
  notifications              Notification[]               @relation("NotificationUser")
  notificationActors         Notification[]               @relation("NotificationActor")
  createdFeatureFlags        FeatureFlag[]                @relation("FeatureFlagCreator")
  analyticsEvents            AnalyticsEvent[]
  auditLogsActor             AuditLog[]                   @relation("AuditActor")
  auditLogsTargetUser        AuditLog[]                   @relation("AuditTargetUser")
  datePlansCreated           DatePlan[]                   @relation("DatePlanCreator")
  datePlanResponses          DatePlanResponse[]
  postDateCheckIns           PostDateCheckIn[]
  scenes                     Scene[]
  privateStoriesOwned        PrivateStory[]              @relation("PrivateStoryOwner")
  privateStoryGrants         PrivateStoryGrant[]         @relation("PrivateStoryRecipient")
  followsSent                PrivateFollow[]             @relation("PrivateFollowRequester")
  followsReceived            PrivateFollow[]             @relation("PrivateFollowOwner")
  privateCommunity           PrivateCommunityPreference?
  vibes                      VibeMedia[]
  wingmanPartiesCreated      WingmanParty[]       @relation("WingmanPartyCreator")
  wingmanMemberships         WingmanPartyMember[]
  wingmanInvitationsSent     WingmanInvitation[]  @relation("WingmanInvitationInviter")
  wingmanInvitationsReceived WingmanInvitation[]  @relation("WingmanInvitationInvitee")
  wingmanVotes               WingmanPartyVote[]

  @@index([status, deletedAt])
  @@index([lastActiveAt])
}

model UserSession {
  id                             String         @id @default(uuid()) @db.Uuid
  userId                         String         @db.Uuid
  deviceId                       String?        @db.VarChar(128)
  deviceName                     String?        @db.VarChar(128)
  platform                       ClientPlatform @default(UNKNOWN)
  appVersion                     String?        @db.VarChar(64)
  ipAddress                      String?        @db.VarChar(64)
  userAgent                      String?        @db.VarChar(500)
  currentRefreshTokenHash        String         @db.VarChar(128)
  currentRefreshTokenJti         String         @unique @db.VarChar(64)
  previousRefreshTokenHash       String?        @db.VarChar(128)
  previousRefreshTokenJti        String?        @db.VarChar(64)
  previousRefreshTokenGraceUntil DateTime?
  refreshTokenExpiresAt          DateTime
  lastSeenAt                     DateTime?
  revokedAt                      DateTime?
  revokedReason                  String?        @db.VarChar(128)
  deletedAt                      DateTime?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  pushTokens      PushToken[]
  analyticsEvents AnalyticsEvent[]
  auditLogs       AuditLog[]

  @@index([userId, revokedAt])
  @@index([refreshTokenExpiresAt])
  @@index([lastSeenAt])
}

model PushToken {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  sessionId     String?        @db.Uuid
  token         String         @unique @db.VarChar(512)
  platform      ClientPlatform
  provider      PushProvider
  deviceId      String?        @db.VarChar(128)
  lastSeenAt    DateTime?
  invalidatedAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  session    UserSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  deliveries PushDelivery[]

  @@index([userId, invalidatedAt])
  @@index([sessionId])
}

enum OccupationCategory {
  TECHNOLOGY
  HEALTHCARE
  EDUCATION
  CREATIVE
  BUSINESS
  HOSPITALITY
  STUDENT
  OTHER
}

model UserProfile {
  id                          String                                 @id @default(uuid()) @db.Uuid
  userId                      String                                 @unique @db.Uuid
  displayName                 String?                                @db.VarChar(80)
  headline                    String?                                @db.VarChar(140)
  bio                         String?                                @db.Text
  dateOfBirth                 DateTime?
  gender                      ProfileGender?
  pronouns                    String?                                @db.VarChar(80)
  city                        String?                                @db.VarChar(120)
  region                      String?                                @db.VarChar(120)
  countryCode                 String?                                @db.Char(2)
  locationLat                 Decimal?                               @db.Decimal(9, 6)
  locationLng                 Decimal?                               @db.Decimal(9, 6)
  locationGeohash             String?                                @db.VarChar(12)
  locationUpdatedAt           DateTime?
  /// Maintained by the database from locationLng/locationLat. Longitude is X.
  locationPoint               Unsupported("geography(Point, 4326)")?
  hideAge                     Boolean                                @default(false)
  hideDistance                Boolean                                @default(false)
  isHidden                    Boolean                                @default(false)
  isIncognito                 Boolean                                @default(false)
  hideFromContacts            Boolean                                @default(false)
  isPaused                    Boolean                                @default(false)
  verificationStatus          ProfileVerificationStatus              @default(UNVERIFIED)
  preferredRelationshipPace   RelationshipPace?
  occupation                  String?                                @db.VarChar(80)
  occupationCategory          OccupationCategory?
  shareWorkDetails            Boolean                                @default(false)
  languages                   String[]                               @default([])
  foodPreferences             String[]                               @default([])
  relocationOpenness          String?                                @db.VarChar(80)
  careerPriority              String?                                @db.VarChar(80)
  familyInvolvementComfort    String?                                @db.VarChar(120)
  marriageTimeline            String?                                @db.VarChar(80)
  childrenPreference          String?                                @db.VarChar(80)
  religionSpirituality        String?                                @db.VarChar(120)
  shareSensitiveCompatibility Boolean                                @default(false)
  promptResponses             Json                                   @default("[]")
  isComplete                  Boolean                                @default(false)
  completedAt                 DateTime?
  deletedAt                   DateTime?
  createdAt                   DateTime                               @default(now())
  updatedAt                   DateTime                               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([isComplete, isHidden, deletedAt])
  @@index([countryCode, city])
  @@index([locationGeohash])
}

/// A follow is a one-way, owner-approved private connection.
model PrivateFollow {
  requesterId String @db.Uuid
  ownerId String @db.Uuid
  status String @default("PENDING") @db.VarChar(12)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requester User @relation("PrivateFollowRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner User @relation("PrivateFollowOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  @@id([requesterId, ownerId])
  @@index([ownerId, status])
}

/// Sensitive selections are only returned to their owner.
model PrivateCommunityPreference {
  userId String @id @db.Uuid
  identifyAs String[] @default([])
  connectWith String[] @default([])
  optedInCommunities String[] @default([])
  selfDescription String? @db.VarChar(120)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PrivateStory {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  text String @default("") @db.VarChar(2000)
  mediaBucket String? @db.VarChar(128)
  mediaObjectKey String? @db.VarChar(512)
  mediaMimeType String? @db.VarChar(64)
  mediaSizeBytes Int?
  moderationStatus ContentModerationStatus @default(PENDING)
  moderatedAt DateTime?
  audienceRule String @db.VarChar(16)
  communityFilter String? @db.VarChar(32)
  expiresAt DateTime
  savedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("PrivateStoryOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  grants PrivateStoryGrant[]
  reports Report[] @relation("ReportTargetPrivateStory")
  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([expiresAt, deletedAt])
  @@index([moderationStatus, createdAt(sort: Desc), id(sort: Desc)])
}

model PrivateStoryGrant {
  storyId String @db.Uuid
  recipientId String @db.Uuid
  createdAt DateTime @default(now())
  story PrivateStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  recipient User @relation("PrivateStoryRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  @@id([storyId, recipientId])
  @@index([recipientId, storyId])
}

model Scene {
  id                String      @id @default(uuid()) @db.Uuid
  ownerId           String      @db.Uuid
  photoId           String?     @db.Uuid
  lineageId         String      @db.Uuid
  version           Int         @default(1)
  intent            SceneIntent
  activity          String      @db.VarChar(120)
  canonicalActivity String      @db.VarChar(80)
  activityTokens    String[]    @default([])
  tags              String[]    @default([])
  availableFrom     DateTime?
  availableUntil    DateTime?
  expiresAt         DateTime
  status            SceneStatus @default(ACTIVE)
  endedAt           DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  owner User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  photo ProfilePhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  wingmanConsents WingmanPartyMember[]
  wingmanVoteSources        WingmanPartyVote[] @relation("WingmanVoteSourceScene")
  wingmanVoteTargetOwners   WingmanPartyVote[] @relation("WingmanVoteTargetOwnerScene")
  wingmanVoteTargetBuddies  WingmanPartyVote[] @relation("WingmanVoteTargetBuddyScene")

  @@unique([lineageId, version])
  @@index([ownerId, status, expiresAt])
  @@index([photoId])
  @@index([intent, canonicalActivity, status, expiresAt])
  @@index([expiresAt, status])
}

model WingmanParty {
  id                String             @id @default(uuid()) @db.Uuid
  status            WingmanPartyStatus @default(PENDING)
  createdByUserId   String             @db.Uuid
  membershipVersion Int                @default(1)
  activatedAt       DateTime?
  disconnectedAt    DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  creator    User                  @relation("WingmanPartyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members    WingmanPartyMember[]
  invitation WingmanInvitation?
  votesCast          WingmanPartyVote[]      @relation("WingmanVoteSourceParty")
  votesReceived      WingmanPartyVote[]      @relation("WingmanVoteTargetParty")
  pairMatchesLow     WingmanPairMatch[]      @relation("WingmanPairMatchLowParty")
  pairMatchesHigh    WingmanPairMatch[]      @relation("WingmanPairMatchHighParty")

  @@index([createdByUserId, status])
  @@index([status, updatedAt])
}

model WingmanPartyMember {
  id                    String                   @id @default(uuid()) @db.Uuid
  partyId               String                   @db.Uuid
  userId                String                   @db.Uuid
  role                  WingmanMembershipRole
  status                WingmanMembershipStatus
  consentedSceneId      String?                  @db.Uuid
  consentedSceneVersion Int?
  sceneConsentedAt      DateTime?
  joinedAt              DateTime?
  disconnectedAt        DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  party          WingmanParty @relation(fields: [partyId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  consentedScene Scene?       @relation(fields: [consentedSceneId], references: [id], onDelete: SetNull)

  @@unique([partyId, userId])
  @@index([userId, status])
  @@index([partyId, status])
  @@index([consentedSceneId])
}

model WingmanInvitation {
  id            String                   @id @default(uuid()) @db.Uuid
  partyId       String                   @unique @db.Uuid
  inviterUserId String                   @db.Uuid
  inviteeUserId String                   @db.Uuid
  tokenHash     String                   @unique @db.VarChar(64)
  status        WingmanInvitationStatus  @default(PENDING)
  expiresAt     DateTime
  consumedAt    DateTime?
  declinedAt    DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  party   WingmanParty @relation(fields: [partyId], references: [id], onDelete: Restrict)
  inviter User         @relation("WingmanInvitationInviter", fields: [inviterUserId], references: [id], onDelete: Restrict)
  invitee User         @relation("WingmanInvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Restrict)

  @@index([inviteeUserId, status, expiresAt])
  @@index([inviterUserId, status, expiresAt])
  @@index([status, expiresAt])
}

model WingmanPartyVote {
  id                       String               @id @default(uuid()) @db.Uuid
  voterUserId              String               @db.Uuid
  sourcePartyId            String               @db.Uuid
  targetPartyId            String               @db.Uuid
  decision                 WingmanVoteDecision
  sourceMembershipVersion  Int
  targetMembershipVersion  Int
  sourceSceneId            String               @db.Uuid
  sourceSceneVersion       Int
  targetOwnerSceneId       String               @db.Uuid
  targetOwnerSceneVersion  Int
  targetBuddySceneId       String               @db.Uuid
  targetBuddySceneVersion  Int
  pairMatchId              String?              @db.Uuid
  matchedAt                DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  voter            User              @relation(fields: [voterUserId], references: [id], onDelete: Restrict)
  sourceParty      WingmanParty      @relation("WingmanVoteSourceParty", fields: [sourcePartyId], references: [id], onDelete: Restrict)
  targetParty      WingmanParty      @relation("WingmanVoteTargetParty", fields: [targetPartyId], references: [id], onDelete: Restrict)
  sourceScene      Scene             @relation("WingmanVoteSourceScene", fields: [sourceSceneId], references: [id], onDelete: Restrict)
  targetOwnerScene Scene             @relation("WingmanVoteTargetOwnerScene", fields: [targetOwnerSceneId], references: [id], onDelete: Restrict)
  targetBuddyScene Scene             @relation("WingmanVoteTargetBuddyScene", fields: [targetBuddySceneId], references: [id], onDelete: Restrict)
  pairMatch        WingmanPairMatch? @relation(fields: [pairMatchId], references: [id], onDelete: SetNull)

  @@unique([sourcePartyId, targetPartyId, voterUserId])
  @@index([voterUserId, decision, updatedAt])
  @@index([sourcePartyId, targetPartyId, decision])
  @@index([targetPartyId, sourcePartyId, decision])
  @@index([pairMatchId])
}

model WingmanPairMatch {
  id                         String                  @id @default(uuid()) @db.Uuid
  partyLowId                 String                  @db.Uuid
  partyHighId                String                  @db.Uuid
  partyLowMembershipVersion  Int
  partyHighMembershipVersion Int
  status                     WingmanPairMatchStatus  @default(ACTIVE)
  matchedAt                  DateTime                @default(now())
  endedAt                    DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  partyLow  WingmanParty       @relation("WingmanPairMatchLowParty", fields: [partyLowId], references: [id], onDelete: Restrict)
  partyHigh WingmanParty       @relation("WingmanPairMatchHighParty", fields: [partyHighId], references: [id], onDelete: Restrict)
  votes     WingmanPartyVote[]
  conversation Conversation?

  @@unique([partyLowId, partyHighId])
  @@index([partyLowId, status, matchedAt])
  @@index([partyHighId, status, matchedAt])
  @@index([status, matchedAt])
}

model ProfilePhoto {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @db.Uuid
  objectKey        String                @db.VarChar(512)
  bucket           String                @db.VarChar(128)
  mimeType         String                @db.VarChar(128)
  sizeBytes        Int
  width            Int?
  height           Int?
  sha256           String?               @db.VarChar(128)
  position         Int                   @default(0)
  isPrimary        Boolean               @default(false)
  purpose          PhotoPurpose          @default(PROFILE)
  moderationStatus PhotoModerationStatus @default(PENDING)
  moderationReason String?               @db.VarChar(500)
  reviewedAt       DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  reports Report[] @relation("ReportTargetPhoto")
  scenes  Scene[]

  @@index([userId, moderationStatus, deletedAt])
